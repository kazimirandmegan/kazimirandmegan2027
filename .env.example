# Optional. Ask Connie uses OpenAI only when a key is set.
# If this is empty (and the live backend has no key either), Connie
# keeps answering from the built-in knowledge base.
#
# Local site (npm run dev / npm start): put the key in a file named .env
# in this folder (that file is gitignored):
#   OPENAI_API_KEY=sk-...
#
# Live site via Google Apps Script: Project Settings → Script properties
#   OPENAI_API_KEY = sk-...
# Then redeploy the web app (New version). The site URL does not change.
#
# Live site on Netlify (repo deploy, not a drag-and-drop of dist/):
#   Site settings → Environment variables → OPENAI_API_KEY
#
# Optional. Defaults to gpt-4.1-mini, a cheap chat model.
# OPENAI_MODEL=gpt-4.1-mini
OPENAI_API_KEY=
